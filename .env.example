# Copia este archivo como .env (el .env NUNCA se sube a Git) y pon tus valores reales.
# Los encuentras en Supabase → Project Settings → API (o "API Keys").

# URL del proyecto, p. ej. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave PÚBLICA: la "anon" (legacy) o la "publishable" (sb_publishable_...).
# ¡NUNCA pongas aquí la clave service_role ni la secret key!
VITE_SUPABASE_ANON_KEY=tu-clave-publica-de-ejemplo
